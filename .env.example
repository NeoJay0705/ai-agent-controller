# Placeholders only. Never commit, paste, or log real credentials.
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWED_USER_ID=123456789

# Primary mode: reuse the selected provider login from a local Pi auth.json.
PI_FLOW_CONFIG=./config/pi-flow.oauth.example.json
PI_FLOW_AUTH_FILE=/home/YOUR_USER/.pi/agent/auth.json

# API-key alternative: use ./config/pi-flow.example.json and set OPENAI_API_KEY.
# Authentication modes do not fall back to each other.

# Relative paths resolve from the process working directory.
CONTROLLER_DATA_DIR=./data
JOB_CONCURRENCY=2
MAX_PENDING_JOBS=100
MAX_PENDING_STEERING=100
HOST=0.0.0.0
PORT=3000

# Controlled trial policy defaults (milliseconds unless noted)
TRIAL_DURATION_MS=3600000
INVITE_TTL_MS=600000
TRIAL_MAX_JOBS=3
TRIAL_JOB_WINDOW_MS=600000
TRIAL_MAX_JOBS_PER_WINDOW=2
TRIAL_MAX_MESSAGES=100
TRIAL_MESSAGE_WINDOW_MS=60000
TRIAL_MAX_MESSAGES_PER_WINDOW=20
TRIAL_MAX_PENDING_JOBS=2
TRIAL_MAX_SESSIONS=2
# Guest Jobs run one at a time in v1. This limit cannot exceed 1.
# JOB_CONCURRENCY remains the global capacity for the Owner and all workers.
TRIAL_MAX_RUNNING_JOBS=1
TRIAL_SESSION_TOKEN_LIMIT=100000
TRIAL_USER_TOKEN_LIMIT=200000
COMMAND_DIALOG_TTL_MS=300000
CONTROL_MAX_PER_MINUTE=10
